{
    "manifest_version": 3,
    "name": "Tab Time Tracker",
    "version": "1.0",
    "description": "Track time spent on browser tabs with a floating UI",
    "permissions": [
      "tabs",
      "storage",
      "activeTab",
      "scripting"
    ],
    "action": {
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      },
      "default_title": "Tab Time Tracker"
    },
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "host_permissions": [
      "<all_urls>"
    ]
  }